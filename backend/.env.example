PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/fixly
# Opcional: si se omite, CORS mantiene el comportamiento anterior y permite cualquier origen.
# CORS_ORIGIN=http://localhost:4200
# Opcional: servidor mostrado en Swagger.
# SWAGGER_SERVER_URL=http://localhost:3000
# Ejemplo únicamente: reemplázalo por un secreto aleatorio antes de usarlo.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
JWT_EXPIRES_IN=1h
# Ejemplos únicamente: cambia nombre, correo y contraseña en tu .env local.
FIXLY_ADMIN_NAME=Administrador de desarrollo
FIXLY_ADMIN_EMAIL=admin@example.test
FIXLY_ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_SEGURA
# El reset solo está habilitado localmente con confirmación explícita.
NODE_ENV=development
ALLOW_DESTRUCTIVE_SEED_RESET=false
